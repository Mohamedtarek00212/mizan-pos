NODE_ENV=production
PORT=4000
HOST=0.0.0.0
DATABASE_URL=postgres://mizan_app:REPLACE_WITH_DATABASE_PASSWORD@postgres:5432/mizan
DB_POOL_MAX=20
JWT_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
JWT_EXPIRES_IN=8h
CORS_ORIGIN=mizan://app,https://pos.example.com
LOG_LEVEL=info
CARD_GATEWAY_MODE=capture
TRUST_PROXY=true
LOGIN_RATE_LIMIT_WINDOW_MS=900000
LOGIN_RATE_LIMIT_MAX=10
RUN_MIGRATIONS_ON_START=false
