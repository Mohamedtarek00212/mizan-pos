# Server
NODE_ENV=development
PORT=4000
HOST=127.0.0.1

# Database (PostgreSQL)
DATABASE_URL=postgres://pos_user:pos_password@localhost:55432/pos_db
DB_POOL_MAX=10

# Auth
JWT_SECRET=change-this-to-a-long-random-secret
JWT_EXPIRES_IN=8h

# CORS
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174,mizan://app

# Logging
LOG_LEVEL=info

# Sandbox adapter until a real card-terminal provider is selected:
# capture (default), decline, or ambiguous.
CARD_GATEWAY_MODE=capture

# Production hardening
TRUST_PROXY=false
LOGIN_RATE_LIMIT_WINDOW_MS=900000
LOGIN_RATE_LIMIT_MAX=10
RUN_MIGRATIONS_ON_START=false
